{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": false,
    "declarationMap": true,

    "rootDir": "src",
    "outDir": "dist",

    "module": "ESNext",
    "target": "ES2022",
    "moduleResolution": "Bundler",

    "typeRoots": ["../../types", "../../node_modules/@types"]
  },
  "include": ["src/**/*"],
  "exclude": ["dist", "node_modules"]
}
