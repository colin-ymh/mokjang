{
  "name": "@mokjang/constants",
  "version": "0.1.0",
  "private": true,
  "sideEffects": false,

  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",

  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },

  "files": ["dist"],

  "scripts": {
    "barrels": "node ../../scripts/make-barrels.mjs constants",
    "build": "npm run barrels && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .. --ext .ts,.tsx",
    "format": "prettier -w .."
  }
}
