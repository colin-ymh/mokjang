{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": false,

    "declaration": true,
    "emitDeclarationOnly": true,

    "rootDir": "src",
    "outDir": "dist",

    "typeRoots": ["../../types", "../../node_modules/@types"],

    "jsx": "react-jsx"
  },
  "include": [
    "src/**/*",
    "../../types/**/*.d.ts"
  ],
  "exclude": ["dist", "node_modules"]
}
