{
  "name": "mokjang",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:app": "npm --workspace @mokjang/app run dev",
    "build:app": "npm --workspace @mokjang/app run build",
    "start:app": "npm --workspace @mokjang/app run start",
    "lint:app": "npm --workspace @mokjang/app run lint",
    "dev:landing": "npm --workspace @mokjang/landing run dev",
    "build:landing": "npm --workspace @mokjang/landing run build",
    "start:landing": "npm --workspace @mokjang/landing run start",
    "lint:landing": "npm --workspace @mokjang/landing run lint",
    "dev": "turbo run dev --parallel --filter=@mokjang/*",
    "build": "turbo run build --filter=@mokjang/*",
    "lint": "turbo run lint --filter=@mokjang/*",
    "typecheck": "turbo run typecheck --filter=@mokjang/*",
    "format": "turbo run format --filter=@mokjang/*",
    "barrels": "node scripts/make-barrels.mjs",
    "barrels:constants": "node scripts/make-barrels.mjs constants",
    "barrels:components": "node scripts/make-barrels.mjs components",
    "barrels:utils": "node scripts/make-barrels.mjs utils",
    "barrels:assets": "node scripts/make-barrels.mjs assets",
    "barrels:models": "node scripts/make-barrels.mjs models"
  },
  "devDependencies": {
    "dotenv": "^17.2.1",
    "turbo": "^2.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18.18 <23"
  },
  "packageManager": "npm@11.2.0",
  "dependencies": {
    "react-easy-crop": "^5.5.0"
  }
}
