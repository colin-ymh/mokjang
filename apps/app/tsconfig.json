{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": "./",
    "paths": {
      "@/*": ["./src/*"]
    },
    "allowJs": true,
    "jsx": "preserve",
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "src",
    "next.config.js",
    ".next/types/**/*.ts",
    "../../packages/components/src/layout/popup-header-bar.tsx",
    "../../packages/components/src/layout/popup-header-bar.view.tsx"
  ],
  "exclude": ["node_modules"]
}
