{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "dist/**",
        "!**/.next/cache/**"
      ],
      "env": [
        "NEXT_PUBLIC_SERVER_PROTOCOL",
        "NEXT_PUBLIC_SERVER_HOST",
        "NEXT_PUBLIC_TEST_SERVER_PROTOCOL",
        "NEXT_PUBLIC_TEST_SERVER_HOST",
        "NEXT_PUBLIC_APP_CLIENT_PROTOCOL",
        "NEXT_PUBLIC_APP_CLIENT_HOST",
        "NEXT_PUBLIC_LANDING_CLIENT_PROTOCOL",
        "NEXT_PUBLIC_LANDING_CLIENT_HOST",
        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY",
        "SUPABASE_SERVICE_ROLE_KEY"
      ]
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "outputs": []
    },
    "format": {
      "outputs": []
    }
  }
}
